{
  "name": "ux-reference-studio",
  "productName": "UX Reference Studio",
  "version": "0.1.0",
  "description": "웹 페이지를 캡처하고 Claude로 정보구조·와이어프레임·UX 패턴을 분석해 레퍼런스로 저장하는 데스크톱 앱",
  "author": "UX Reference Studio",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check electron/analyzer.js && node --check electron/capture.js && node --check electron/settings.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "^2.117.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.uxreferencestudio.app",
    "productName": "UX Reference Studio",
    "copyright": "Copyright © 2026 UX Reference Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "UX Reference Studio"
    }
  }
}
